[configuration]

entry_symbol = "gfgd_library_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]
; Relative paths ensure that this addon folder can be placed anywhere in the project directory.
macos.single.debug = "./bin/macos/libGFGD.macos.template_debug.dylib"
macos.double.debug = "./bin/macos/libGFGD.macos.template_debug.double.dylib"
macos.single.release = "./bin/macos/libGFGD.macos.template_release.dylib"
macos.double.release = "./bin/macos/libGFGD.macos.template_release.double.dylib"
macos.single.debug.editor = "./bin/macos/libGFGD.macos.editor.dylib"

ios.arm64.single.debug = "./bin/ios/libGFGD.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "./bin/ios/libGFGD.ios.template_debug.arm64.double.dylib"
ios.arm64.single.release = "./bin/ios/libGFGD.ios.template_release.arm64.dylib"
ios.arm64.double.release = "./bin/ios/libGFGD.ios.template_release.arm64.double.dylib"

windows.x86_32.single.debug = "./bin/windows/GFGD.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "./bin/windows/GFGD.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.release = "./bin/windows/GFGD.windows.template_release.x86_32.dll"
windows.x86_32.double.release = "./bin/windows/GFGD.windows.template_release.x86_32.double.dll"

windows.x86_64.single.debug = "./bin/windows/GFGD.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./bin/windows/GFGD.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./bin/windows/GFGD.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./bin/windows/GFGD.windows.template_release.x86_64.double.dll"
windows.x86_64.single.debug.editor = "./bin/windows/GFGD.windows.editor.x86_64.dll"

linux.x86_64.single.debug = "./bin/linux/libGFGD.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./bin/linux/libGFGD.linux.template_debug.x86_64.double.so"
linux.x86_64.single.release = "./bin/linux/libGFGD.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./bin/linux/libGFGD.linux.template_release.x86_64.double.so"
linux.x86_64.single.debug.editor = "./bin/linux/libGFGD.linux.editor.x86_64.so"

linux.arm64.single.debug = "./bin/linux/libGFGD.linux.template_debug.arm64.so"
linux.arm64.double.debug = "./bin/linux/libGFGD.linux.template_debug.arm64.double.so"
linux.arm64.single.release = "./bin/linux/libGFGD.linux.template_release.arm64.so"
linux.arm64.double.release = "./bin/linux/libGFGD.linux.template_release.arm64.double.so"
linux.arm64.single.debug.editor = "./bin/linux/libGFGD.linux.editor.arm64.so"

android.x86_64.single.debug = "./bin/android/libGFGD.android.template_debug.x86_64.so"
android.x86_64.double.debug = "./bin/android/libGFGD.android.template_debug.x86_64.double.so"
android.x86_64.single.release = "./bin/android/libGFGD.android.template_release.x86_64.so"
android.x86_64.double.release = "./bin/android/libGFGD.android.template_release.x86_64.double.so"

android.arm64.single.debug = "./bin/android/libGFGD.android.template_debug.arm64.so"
android.arm64.double.debug = "./bin/android/libGFGD.android.template_debug.arm64.double.so"
android.arm64.single.release = "./bin/android/libGFGD.android.template_release.arm64.so"
android.arm64.double.release = "./bin/android/libGFGD.android.template_release.arm64.double.so"

web.wasm32.single.debug = "./bin/web/libGFGD.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "./bin/web/libGFGD.web.template_debug.wasm32.double.nothreads.wasm"
web.wasm32.single.release = "./bin/web/libGFGD.web.template_release.wasm32.nothreads.wasm"
web.wasm32.double.release = "./bin/web/libGFGD.web.template_release.wasm32.double.nothreads.wasm"
