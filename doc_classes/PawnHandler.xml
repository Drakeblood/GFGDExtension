<?xml version="1.0" encoding="UTF-8" ?>
<class name="PawnHandler" inherits="Node" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Makes a scene possessable and is where input bindings are declared.
	</brief_description>
	<description>
		Add one to a pawn scene - as the root or as any descendant - to make it possessable. Override [code]_setup_input_component[/code] and bind actions on the [InputComponent] passed to it. That runs on possession, not on [code]_ready[/code], so binding input from [code]_ready[/code] will not work.
	</description>
