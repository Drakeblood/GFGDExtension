<?xml version="1.0" encoding="UTF-8" ?>
<class name="AssertionMessages" inherits="Object" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Message formatting used by [Assert].
	</brief_description>
	<description>
		Builds the human-readable text for a failed assertion.
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="boolean_failure_message" qualifiers="static">
			<return type="String" />
			<param index="0" name="expected" type="bool" />
			<description>
				Composes the text for a boolean check against [param expected].
			</description>
		</method>
		<method name="get_equality_message" qualifiers="static">
			<return type="String" />
			<param index="0" name="actual" type="Variant" />
			<param index="1" name="expected" type="Variant" />
			<param index="2" name="expect_equal" type="bool" />
			<description>
				Composes the text for an equality check: reads [code]Values are not equal.[/code] with [code]actual == expected[/code] when [param expect_equal] is true, and the reverse when it is false.
			</description>
		</method>
		<method name="get_message" qualifiers="static">
			<return type="String" />
			<param index="0" name="failure_message" type="String" />
			<description>
				Prefixes [param failure_message] with [code]Assertion failure: [/code].
			</description>
		</method>
		<method name="get_message_with_expected" qualifiers="static">
			<return type="String" />
			<param index="0" name="failure_message" type="String" />
			<param index="1" name="expected" type="String" />
			<description>
				As [method get_message], with [code] Expected: &lt;expected&gt;[/code] appended.
			</description>
		</method>
		<method name="null_failure_message" qualifiers="static">
			<return type="String" />
			<param index="0" name="value" type="Variant" />
			<param index="1" name="expect_null" type="bool" />
			<description>
				Composes the text for a null check, phrased for whichever outcome [param expect_null] asked for.
			</description>
		</method>
	</methods>
</class>
