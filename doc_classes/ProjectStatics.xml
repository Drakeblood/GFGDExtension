<?xml version="1.0" encoding="UTF-8" ?>
<class name="ProjectStatics" inherits="Object" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Static helpers, currently save game loading and storing.
	</brief_description>
	<description>
		Writes a [SaveGame] to [code]user://saves/[/code], optionally encrypted.
	</description>
	<tutorials>
	</tutorials>
